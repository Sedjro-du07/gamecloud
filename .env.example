# GameCloud OS — example environment file.
# Copy to `.env` and fill in. Both `gamecloud-web` and `gamecloud-bot`
# read the variables they need from the same file in development.
#
# See QUICKSTART.md for a step-by-step setup guide.

# ============================================================
# Common
# ============================================================
APP_ENV=dev
PUBLIC_ORIGIN=http://localhost:3000
BIND_ADDR=0.0.0.0:3000

DATABASE_URL=postgres://gamecloud:gamecloud@localhost:5432/gamecloud_dev

# ============================================================
# JWT
# ============================================================
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes.
JWT_SECRET=change-me-to-a-32-byte-or-more-random-string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
JWT_QR_TTL=7200

# ============================================================
# Discord OAuth (web binary) — REQUIRED
# ============================================================
# Get them from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ============================================================
# Discord bot — REQUIRED to run gamecloud-bot
# (web binary doesn't need DISCORD_TOKEN, only the bot does)
# ============================================================
DISCORD_TOKEN=
DRAFTBOT_CHANNEL_ID=
DRAFTBOT_USER_ID=
GAMECLOUD_SYNC_URL=http://localhost:3000
OUTBOX_POLL_SECONDS=5

# Shared between web (verifies inbound DraftBot syncs) and bot
# (sends outbound). Use the same random value in both processes.
DRAFTBOT_API_KEY=change-me-to-a-random-string

# ============================================================
# GitHub webhook — OPTIONAL
# (when absent, /api/webhooks/github returns 503 but everything
# else keeps working. Leave empty for local dev.)
# ============================================================
GITHUB_WEBHOOK_SECRET=

# ============================================================
# SMTP — REQUIRED to receive OTP codes for email verification
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GameCloud <noreply@gamecloud.local>

# ============================================================
# Supabase — OPTIONAL
# (used for project file uploads in a later phase. Leave empty
# for the current MVP — the web binary won't crash without it.)
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
