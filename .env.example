# GameCloud OS — example environment file.
# Copy to `.env` and fill in. Both `gamecloud-web` and `gamecloud-bot`
# read the variables they need from the same file in development.
#
# IMPORTANT: every secret below must be replaced with a generated value.
# The server refuses to start if JWT_SECRET, DRAFTBOT_API_KEY or
# GITHUB_WEBHOOK_SECRET is shorter than 32 bytes or still carries one of
# the placeholder prefixes in this file. Generate each one with:
#
#     openssl rand -base64 48
#
# See QUICKSTART.md for a step-by-step setup guide.

# ============================================================
# Common
# ============================================================
APP_ENV=dev
PUBLIC_ORIGIN=http://localhost:3000
BIND_ADDR=0.0.0.0:3000

DATABASE_URL=postgres://gamecloud:gamecloud@localhost:5432/gamecloud_dev

# ============================================================
# JWT
# ============================================================
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes.
JWT_SECRET=change-me-to-a-32-byte-or-more-random-string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
JWT_QR_TTL=7200

# ============================================================
# Discord OAuth (web binary) — REQUIRED
# ============================================================
# Get them from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ============================================================
# Discord bot — REQUIRED to run gamecloud-bot
# (web binary doesn't need DISCORD_TOKEN, only the bot does)
# ============================================================
DISCORD_TOKEN=
DRAFTBOT_CHANNEL_ID=
DRAFTBOT_USER_ID=
GAMECLOUD_SYNC_URL=http://localhost:3000
OUTBOX_POLL_SECONDS=5

# Shared between web (verifies inbound DraftBot syncs) and bot
# (sends outbound). Use the same random value in both processes.
DRAFTBOT_API_KEY=change-me-to-a-random-string

# ============================================================
# GitHub webhook — OPTIONAL
# (when absent, /api/webhooks/github returns 503 but everything
# else keeps working. Leave empty for local dev.)
# ============================================================
GITHUB_WEBHOOK_SECRET=

# ============================================================
# SMTP — REQUIRED to receive OTP codes for email verification
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GameCloud <noreply@gamecloud.local>

# ============================================================
# Supabase — OPTIONAL
# (used for project file uploads in a later phase. Leave empty
# for the current MVP — the web binary won't crash without it.)
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===========================================================================
# Announcements (optional)
# ===========================================================================
# Discord channel that receives rank-ups, badges, quest completions and
# project releases. Leave unset and the platform stays silent — the
# outbox rows are simply not written.
DISCORD_ANNOUNCE_CHANNEL_ID=

# Guild whose roles mirror platform ranks. Leave unset and the bot never
# touches anybody's roles. Create one Discord role per rank, named
# exactly after the rank title (e.g. "🌱 L'Initié"); the bot finds roles
# by name and never creates them.
DISCORD_GUILD_ID=
# How often to reconcile every member's rank role, in seconds.
ROLE_SYNC_SECONDS=900

# ===========================================================================
# Rate limiting
# ===========================================================================
# Requests per IP per minute. "Sensitive" covers the OTP endpoints, login,
# QR scanning and the DraftBot sync.
RATE_LIMIT_SENSITIVE_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# Set to "true" ONLY when a reverse proxy you control overwrites
# X-Forwarded-For. Otherwise callers can spoof the header to dodge the
# limiter.
TRUST_FORWARDED_FOR=false

# Routage des annonces par type. Chaque variable est optionnelle : sans
# elle, l'annonce retombe sur DISCORD_ANNOUNCE_CHANNEL_ID — sauf le
# journal, qui n'a pas de repli parce qu'une ligne d'audit nomme qui a
# fait quoi à qui.
DISCORD_QUESTS_CHANNEL_ID=
DISCORD_LEADERBOARD_CHANNEL_ID=
DISCORD_HALL_CHANNEL_ID=
DISCORD_REVIEWS_CHANNEL_ID=
DISCORD_JOURNAL_CHANNEL_ID=
# Salon privé du Bureau : réunions du Bureau, et journal d'audit quand
# DISCORD_JOURNAL_CHANNEL_ID est vide. Aucun repli vers un salon public.
DISCORD_BUREAU_CHANNEL_ID=
# Salon où le bot tient un guide à jour (un seul message, modifié sur
# place). Le classement est tenu de la même façon dans
# DISCORD_LEADERBOARD_CHANNEL_ID.
DISCORD_GUIDE_CHANNEL_ID=
# Salon où chaque présence scannée par QR est annoncée. Sans repli.
DISCORD_PRESENCES_CHANNEL_ID=
# Transformer les montées de niveau DraftBot en XP (true/false). À false
# tant que DraftBot est suspendu : la plateforme est le seul système d'XP.
DRAFTBOT_ENABLED=true

# Un salon par track, sous la forme Track=id séparés par des virgules.
# Une demande de revue atterrit dans le salon de la discipline concernée
# plutôt que dans une file générique que personne ne lit.
DISCORD_TRACK_CHANNELS=Engineering=...,GameDesign=...,Narrative=...,VisualArt=...,Audio=...,Production=...,QA=...,Marketing=...

# ===========================================================================
# GitHub (création automatique des dépôts de projet)
# ===========================================================================
# Sans ces deux variables, un projet est créé sans dépôt et le champ
# github_repo_url reste à remplir à la main.
#
# Le token doit être un PAT « fine-grained » limité à cette organisation,
# avec la permission Administration en lecture et écriture. C'est ce qui
# autorise la création de dépôts et la pose du webhook.
GITHUB_ORG=Epitech-Game-Cloud-Association
GITHUB_TOKEN=

# ============================================================
# Partages (scripts, lore, jeux, assets déposés par les membres)
# ============================================================
# Dossier où la plateforme garde les fichiers déposés. Il doit survivre
# aux redémarrages : en production, un volume monté.
SHARES_DIR=data/shares

# Salons où la plateforme annonce les nouveaux partages et les ressources
# validées. Laisser vide pour ne rien publier.
DISCORD_SHARES_CHANNEL_ID=
DISCORD_RESOURCES_CHANNEL_ID=

# ============================================================
# Tests d'entrée et admission
# ============================================================
# Dossier des sujets et des rendus (privé). Doit survivre aux redémarrages.
TESTS_DIR=data/tests
# Salon vers lequel pointe l'invitation créée quand le Bureau admet un
# candidat (par exemple le salon de bienvenue). La plateforme lit aussi
# DISCORD_TOKEN et DISCORD_GUILD_ID pour savoir si quelqu'un est déjà sur
# le serveur quand il se connecte.
DISCORD_INVITE_CHANNEL_ID=

# ============================================================
# Relais vers Kumo
# ============================================================
# Un message privé au bot GameCloud OS est posté dans ce salon, où Kumo
# lit ; la réponse de Kumo est renvoyée en privé à qui a écrit.
KUMO_BOT_ID=
KUMO_RELAY_CHANNEL_ID=
